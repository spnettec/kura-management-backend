[Unit]
Description=YOFC independent Kura management console (%i)
After=network.target
ConditionPathExists=/etc/kura-management-console-%i/console.env

[Service]
Type=simple
User=yofc-console
Group=yofc-console
EnvironmentFile=/etc/kura-management-console-%i/console.env
WorkingDirectory=/usr/share/kura-management-console
ExecStartPre=+/usr/bin/python3 /usr/lib/kura-management-console/setup.py --instance %i check
ExecStart=/usr/bin/yofc-management-console serve
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=128
MemoryMax=768M
CPUWeight=50

[Install]
WantedBy=multi-user.target
