[Unit]
Description=YOFC independent Kura management console
After=network.target
ConditionPathExists=!/var/lib/yofc-console-maintenance/active.json

[Service]
Type=simple
User=yofc-console
Group=yofc-console
Environment=CONSOLE_STATE_DIR=/var/lib/kura-management-console
Environment=CONSOLE_WEB_DIR=/usr/share/kura-management-console/react
EnvironmentFile=-/etc/kura-management-console/console.env
StateDirectory=kura-management-console
StateDirectoryMode=0700
WorkingDirectory=/usr/share/kura-management-console
ExecStartPre=+/usr/bin/python3 /usr/lib/kura-management-console/setup.py launch-check
ExecStart=/usr/bin/yofc-management-console serve
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=128
MemoryMax=768M
CPUWeight=50

[Install]
WantedBy=multi-user.target
