[Unit]
Description=YOFC Kura management console
After=network.target

[Service]
Type=simple
User=kura-console
Group=kura-console
WorkingDirectory=/usr/share/kura-management-console
EnvironmentFile=/etc/kura-management-console/console.env
ExecStart=/usr/bin/yofc-management-console serve
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=kura-management-console
StateDirectoryMode=0700
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=128
MemoryMax=512M

[Install]
WantedBy=multi-user.target
