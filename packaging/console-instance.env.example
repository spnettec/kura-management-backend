# Copy to /etc/kura-management-console@INSTANCE/console.env as root mode 0600.
# INSTANCE is validated as a short lowercase systemd instance name. Every center
# must use a separate database, task key, TLS trust/client identity and ports.
DATABASE_URL=postgresql://kura_management_center2@/kura_management_center2?host=/var/run/postgresql
CONSOLE_DATA_KEY_FILE=/var/lib/kura-management-console-center2/task-data.key
CONSOLE_ORIGIN=https://center2.example.invalid:28443
CONSOLE_HTTP_ADDR=127.0.0.1:28443
CONSOLE_GRPC_ADDR=127.0.0.1:28444
CONSOLE_TLS_CERT=/etc/kura-management-console-center2/tls/server.pem
CONSOLE_TLS_KEY=/etc/kura-management-console-center2/tls/server.key
CONSOLE_CLIENT_CA=/etc/kura-management-console-center2/tls/ca.pem
CONSOLE_WEB_DIR=/usr/share/kura-management-console/react
RUST_LOG=info
