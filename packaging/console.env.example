DATABASE_URL=postgresql://kura_console@localhost/kura_management
CONSOLE_DATA_KEY_FILE=/var/lib/kura-management-console/task-data.key
CONSOLE_ORIGIN=https://console.example.invalid
CONSOLE_HTTP_ADDR=0.0.0.0:443
CONSOLE_GRPC_ADDR=0.0.0.0:8443
CONSOLE_TLS_CERT=/etc/kura-management-console/server.pem
CONSOLE_TLS_KEY=/etc/kura-management-console/server.key
CONSOLE_CLIENT_CA=/etc/kura-management-console/agent-ca.pem
CONSOLE_WEB_DIR=/usr/share/kura-management-console/frontend
RUST_LOG=info
